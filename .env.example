# ---------------------------------------------------------------------------
# Both variables are OPTIONAL. The app builds, runs and generates images with
# no .env file at all — it just falls back to inline images and hides the
# link-share path.
# ---------------------------------------------------------------------------

# Vercel Blob store, used to host the generated share image so an X link preview
# (OG image) shows the real graphic instead of a blank thumbnail.
#
# On Vercel: create a Blob store under Storage and connect it to the project —
# this variable is then injected automatically and you never set it by hand.
# Locally: copy the token from the Vercel dashboard, or `vercel env pull`.
#
# Without it: /api/pass returns 503, the UI says link sharing is unavailable,
# and download plus mobile Web Share still work.
BLOB_READ_WRITE_TOKEN=

# Absolute origin used to build OG/Twitter tags and share links.
# Leave unset on Vercel — it is derived from VERCEL_PROJECT_PRODUCTION_URL.
# Set it for a custom domain, e.g. https://hhgoa.com
NEXT_PUBLIC_SITE_URL=
